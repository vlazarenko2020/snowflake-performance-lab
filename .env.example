# Copy to .env and edit:  cp .env.example .env
# Load with:  set -a; source .env; set +a

# Connection name from ~/.snowflake/config.toml
CONNECTION=default

ROLE=PUBLIC
WAREHOUSE=COMPUTE_WH

# Needed for temp tables (role needs USAGE on both and CREATE TABLE on the schema)
WORK_DB=MY_DB
WORK_SCHEMA=MY_SCHEMA

# Optional: override the generated SQL file location
# SQL_FILE=
